# PostHog — reusar el mismo project del web
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_TEST=false

# Funnel config
VITE_FUNNEL_DEFAULT_SLUG=eventos
VITE_LAUNCH_DATE=2026-09-01

# Lead capture backend (a definir martes 03/06 — opciones: client-gateway, Mailchimp, Formspree)
VITE_LEAD_BACKEND_URL=

# Meta Pixel (a definir martes 03/06)
VITE_META_PIXEL_ID=

# SuperAdmin backend para Meta CAPI server-side
# (opcional: si no se setea, los events solo van via pixel; si está, también via CAPI para recuperar conversions perdidas por adblockers)
VITE_SUPERADMIN_API_URL=

# Calendly (a definir martes 03/06)
VITE_CALENDLY_LINK=
